# Server Configuration
PORT=5000

# Database Configuration (MongoDB Atlas Cloud Database)
# Standard SRV Connection String:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/careermatch_ai?retryWrites=true&w=majority

# Direct Shard Connection String (Optional, for Windows SRV DNS bypass):
# MONGODB_DIRECT_URI=mongodb://<user>:<pass>@shard0:27017,shard1:27017,shard2:27017/careermatch_ai?ssl=true&replicaSet=xxxx&authSource=admin&retryWrites=true&w=majority

# Fallback Local MongoDB (if offline)
MONGO_URI=mongodb://localhost:27017/careermatch_ai

# Security & Authentication
JWT_SECRET=your_jwt_secret_key_here

# Google Gemini AI API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
